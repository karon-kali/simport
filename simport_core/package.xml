<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simport_core</name>
  <version>1.0.0</version>
  <description>
    ROS-agnostic core of simport: data model (Value, Schema, Record, Frame), YAML configuration
    with precise error reporting, and the Transport/Codec/Framer/Trigger/FrameFilter/Clock
    plugin interfaces.
  </description>
  <maintainer email="karonskali@gmail.com">simport maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
